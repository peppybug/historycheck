# PostgreSQL connection string (local Postgres or Supabase "Session pooler" URI).
DATABASE_URL=postgres://historycheck:historycheck@localhost:5432/historycheck

# Editorial workspace (/admin). Leave ADMIN_PASSWORD empty to disable the workspace.
ADMIN_PASSWORD=
# Random string of at least 32 characters used to sign the admin session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Public URL of the site, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
